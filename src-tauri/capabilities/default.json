{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-vault-status",
    "allow-vault-action",
    "allow-domain-probe",
    "allow-stream-open",
    "allow-stream-ack",
    "allow-stream-cancel",
    "allow-reset-challenge",
    "allow-profiles-list",
    "allow-profile-put",
    "allow-profile-duplicate",
    "allow-profile-delete-prepare",
    "allow-profile-delete",
    "allow-key-import",
    "allow-session-connect",
    "allow-sessions-list",
    "allow-session-confirm-host",
    "allow-session-disconnect",
    "allow-session-close",
    "allow-terminal-open",
    "allow-terminal-action",
    "allow-clipboard-read",
    "allow-clipboard-write",
    "allow-files-list",
    "allow-files-terminal",
    "allow-files-mutate",
    "allow-document-open",
    "allow-document-save",
    "allow-files-release",
    "allow-transfer-select-files",
    "allow-transfer-select-destination",
    "allow-transfer-upload",
    "allow-transfer-download",
    "allow-transfers-list",
    "allow-transfer-action",
