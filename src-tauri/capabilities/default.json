    "allow-workspace-lock",
    "allow-workspace-recover",
    "allow-drafts-list",
    "allow-draft-remove",
    "allow-draft-restore",
    "allow-docker-inventory",
    "allow-docker-inspect",
    "allow-docker-prepare",
    "allow-docker-apply",
    "allow-docker-logs",
    "allow-docker-stream-action",
    "allow-docker-exec",
    "allow-compose-list",
    "allow-compose-register",
    "allow-compose-remove",
    "allow-compose-status",
    "allow-compose-prepare",
    "allow-compose-apply",
    "allow-draft-read",
    "allow-profiles-import",
    "allow-profiles-export"
  ]
}
